
<!DOCTYPE html>
<html>
<head>
    <title>ABC Institute of Technology</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background-color: #fff0e6;
        }

        header {
            background-color: #e65100;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            display: flex;
            justify-content: center;
            background-color: #4e342e;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        section {
            text-align: center;
            padding: 25px;
            margin: 15px;
            background-color: white;
            border-radius: 10px;
        }

        table {
            width: 70%;
            margin: auto;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #795548;
            padding: 12px;
        }

        th {
            background-color: #e65100;
            color: white;
        }

        input, select {
            padding: 10px;
            margin: 8px;
            width: 230px;
        }

        button {
            background-color: #00897b;
            color: white;
            padding: 12px 25px;
            border: none;
            cursor: pointer;
        }

        footer {
            background-color: #4e342e;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @media (max-width: 600px) {
            nav {
                flex-direction: column;
                align-items: center;
            }

            table {
                width: 100%;
            }

            input, select {
                width: 80%;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>ABC INSTITUTE OF TECHNOLOGY</h1>
        <p>Learn Today, Lead Tomorrow</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#courses">Courses</a>
        <a href="#admission">Admission</a>
        <a href="#contact">Contact</a>
    </nav>

    <section id="home">
        <h2>About Our Institute</h2>
        <p>ABC Institute provides excellent education
        and develops students' skills for a bright future.</p>
    </section>

    <section id="courses">
        <h2>Our Courses</h2>

        <table>
            <tr>
                <th>Course</th>
                <th>Duration</th>
            </tr>

            <tr>
                <td>BCA</td>
                <td>3 Years</td>
            </tr>

            <tr>
                <td>B.Sc Computer Science</td>
                <td>3 Years</td>
            </tr>

            <tr>
                <td>BBA</td>
                <td>3 Years</td>
            </tr>

            <tr>
                <td>MBA</td>
                <td>2 Years</td>
            </tr>
        </table>
    </section>

    <section id="admission">
        <h2>Course Admission</h2>

        <form onsubmit="showMessage(event)">

            <input type="text" id="name"
            placeholder="Enter Your Name" required>

            <br>

            <input type="email" id="email"
            placeholder="Enter Your Email" required>

            <br>

            <select id="course" required>
                <option value="">Select Your Course</option>
                <option>BCA</option>
                <option>B.Sc Computer Science</option>
                <option>BBA</option>
                <option>MBA</option>
            </select>

            <br><br>

            <button type="submit">Apply Now</button>

        </form>
    </section>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>Email: info@abcinstitute.com</p>
        <p>Phone: 9876543210</p>
        <p>Address: Vijayawada, Andhra Pradesh</p>
    </section>

    <footer>
        <p>ABC Institute of Technology © 2026</p>
        <p>All Rights Reserved</p>
    </footer>

    <script>
        function showMessage(event) {

            event.preventDefault();

            let name = document.getElementById("name").value;
            let course = document.getElementById("course").value;

            alert("Thank You " + name +
            "! Your admission request for " +
            course + " is submitted.");
        }
    </script>

</body>
</html>
